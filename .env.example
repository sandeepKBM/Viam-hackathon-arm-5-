# Cloud connection (default). The VIAM_-prefixed names are what the live .env
# uses; the unprefixed names are also accepted for backward compatibility.
MACHINE_ADDRESS=armfarm5-main.310sld03v2.viam.cloud
API_KEY=
API_KEY_ID=

# --- Local / direct connection (bypass Viam cloud signaling) ---
# Set VIAM_LOCAL=1 to dial viam-server directly over gRPC with WebRTC disabled.
# Address is the machine's LAN IP:port, or localhost:port if you reverse-tunnel
# the port to this host (see scripts/tunnel_to_arm.sh). Default: localhost:8080.
VIAM_LOCAL=0
VIAM_MACHINE_LOCAL_ADDRESS=localhost:8080
# API-key auth is kept by default even locally. Set to 1 ONLY if the machine's
# network config explicitly allows insecure connections (drops TLS + creds).
VIAM_LOCAL_INSECURE=0

ARM_NAME=arm
CAMERA_NAME=cam
GRIPPER_NAME=gripper
DETECTOR_NAME=vision-1
FLOOR_Z=179.75673
MAX_Y=506.75
